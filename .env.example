# Upstash Redis (from console.upstash.com)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Resend (from resend.com)
RESEND_API_KEY=re_xxxxx

# Email settings
POLL_CREATOR_EMAIL=your_email@example.com
EMAIL_FROM=What It Do <notifications@your-domain.com>

# Your app URL
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Rate limiting (10 polls/hr, 20 votes/hr per IP). Off by default; set to 1 to enable.
RATE_LIMIT_ENABLED=1
