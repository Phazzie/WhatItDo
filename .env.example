# External Redis: configure REDIS_URL for a standard Redis provider, or the two
# Upstash REST variables below. REDIS_URL is preferred when both are present.
# Production must use a plan with persistence that satisfies the retention contract.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (from resend.com)
RESEND_API_KEY=re_xxxxx

# Email settings
POLL_CREATOR_EMAIL=your_email@example.com
EMAIL_FROM=What It Do <notifications@your-domain.com>

# Self-hosted production only: set this when requests arrive through a proxy you control.
# Vercel uses its platform-owned forwarding headers automatically.
# TRUST_PROXY=1

# E2E_TEST / E2E_BASE_URL / USE_IN_MEMORY_REDIS are test-only. Never set them in a deployment.
